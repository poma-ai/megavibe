# required. Both tokens below are INSIDE the container boundary: every issue session runs with permissions bypassed and can read
# them (and has open network access). Use a fine-grained GitHub token limited to this one repository (Issues, Contents, Pull
# requests: read and write), never a classic token with the repo scope, which reaches every repository you can.
GH_TOKEN=
MEGAVIBE_REPO=owner/name

# Claude login: a subscription token from `claude setup-token` ...
CLAUDE_CODE_OAUTH_TOKEN=
# ... or leave it empty and log in once into the claude volume:
#   docker compose -f docker/docker-compose.yml run --rm megavibe claude auth login
# (with a token the readiness pre-check is skipped: it needs a claude.ai login it can read with `claude auth status`)

# what to work on: issue numbers and ranges, and/or issues carrying every label (comma separated, oldest first)
MEGAVIBE_ISSUES=
MEGAVIBE_LABELS=
MEGAVIBE_LABEL_LIMIT=

# concurrency and the most issues ever started (empty: no limit)
MEGAVIBE_MAX=3
MEGAVIBE_TOTAL=

# optional
MEGAVIBE_BASE=
MEGAVIBE_MODEL=
MEGAVIBE_TICKET_SKILL=
MEGAVIBE_PRECHECK=on
MEGAVIBE_ALLOW_PUBLIC=0
MEGAVIBE_TICK_SECS=120
GH_HOST=github.com
GIT_USER_NAME=megavibe
GIT_USER_EMAIL=megavibe-dispatch@localhost.invalid
