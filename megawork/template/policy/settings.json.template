{
  "permissions": {
    "defaultMode": "default",
    "allow": ["Read", "Write", "Edit", "Glob", "Grep", "TodoWrite", "Bash", "Task", "WebSearch", "WebFetch"],
    "deny": ["Bash(sudo:*)", "Read(//**/.ssh/**)", "Read(//**/Keychains/**)", "Read(//**/.aws/**)",
             "mcp__*__send*", "mcp__*__delete*", "mcp__*__archive*", "mcp__*__trash*"]
  },
  "env": { "MEGAWORK_DATA": "@DATA@", "MEGAWORK_ENGINE": "@ENGINE@" },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit",
        "hooks": [ { "type": "command", "command": "'@ENGINE@/hooks/snapshot.sh'" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "'@ENGINE@/hooks/session-start.sh'" } ] }
    ]
  }
}
