; megawork seatbelt profile — the REAL containment boundary.
;
; Claude Code's --restricted mode confines its own file tools but NOT Bash
; (proven: megawork/spike/RESULTS-capable.md, B2/B3 — Bash both wrote and read
; outside the folder). Rather than forbid Bash and cripple the assistant, the
; kernel enforces the boundary and Bash stays available.
;
; Policy: read widely (so the assistant can consult the colleague's material),
; write ONLY inside their folder — which is exactly "read-only access to
; everything else". Secrets are denied even for reading.
;
; Placeholders substituted at install time: @DATA@ @ENGINE@ @HOME@
(version 1)
(allow default)

; ── CRITICAL: block the LaunchServices escape ──
; `open X.app` (or `open <document>`) asks launchd to spawn the target, and
; launchd is OUTSIDE this sandbox — so the child runs unconfined. Verified
; escape; denying the LaunchServices brokers closes it while leaving ordinary
; file work and network untouched. Belt and braces: also refuse to exec the
; usual front-ends (a copied binary loses the signature LaunchServices needs).
(deny mach-lookup (global-name-regex #"^com\.apple\.(lsd|coreservices)"))
(deny appleevent-send)
(deny process-exec
  (literal "/usr/bin/open") (literal "/usr/bin/osascript")
  (literal "/bin/launchctl") (literal "/usr/bin/automator")
  (literal "/usr/bin/qlmanage"))

; ── writes: denied everywhere, then allowed back in narrow places ──
(deny file-write*)
(allow file-write*
  (subpath "@DATA@")                    ; the colleague's four folders
  (subpath "@ENGINE@/logs")             ; our own logs
  (subpath "@ENGINE@/snapshots")        ; undo history (kept out of synced folders)
  (subpath "@ENGINE@/agent")            ; what happened, so tomorrow's session knows
  ; Claude Code writes state all over ~/.claude (projects, todos, session-env,
  ; shell-snapshots, …) and the list grows with each release, so allow the
  ; directory and deny back the parts that EXECUTE in later, unsandboxed
  ; sessions — see the deny block below. Enumerating the allowed subdirs
  ; instead meant a new one broke startup with a raw EPERM in the user's face.
  (subpath "@HOME@/.claude")
  (subpath "@HOME@/.cache")
  ; The Gemini CLI (which the gemini-cli MCP bridge drives) writes its state
  ; here and aborts with EPERM on mkdir if it cannot — the backend never worked
  ; in a session until this was allowed. The OAuth credential file stays denied
  ; for reading below; the API key reaches the CLI as an env var.
  (subpath "@HOME@/.gemini")
  ; npm's cache is redirected into the engine (npm_config_cache in the launcher)
  ; rather than allowing ~/.npm: a writable shared cache is a way to plant code
  ; that a later UNsandboxed `npx` would run.
  (subpath "@ENGINE@/logs/npm-cache")
  (subpath "/private/var/folders")      ; system temp (per-user, not shared)
  (subpath "/private/tmp")
  (literal "/dev/null") (literal "/dev/stdout") (literal "/dev/stderr")
  (literal "/dev/dtracehelper") (literal "/dev/tty"))

; Executable configuration is denied back: these run in LATER sessions, some of
; them unsandboxed, so a session must never be able to edit them. Seatbelt takes
; the last matching rule, so this must stay after the allow above.
(deny file-write*
  (literal "@HOME@/.claude/settings.json")
  (literal "@HOME@/.claude/settings.local.json")
  (literal "@HOME@/.claude/CLAUDE.md")
  (literal "@HOME@/.claude/statusline.sh")
  (subpath "@HOME@/.claude/hooks")
  (subpath "@HOME@/.claude/skills")
  (subpath "@HOME@/.claude/agents")
  (subpath "@HOME@/.claude/plugins")
  (subpath "@HOME@/.claude/commands")
  ; The Gemini CLI's own executable configuration: settings.json carries
  ; mcpServers/hooks that run a command at every start (and the flash model
  ; pin), GEMINI.md/extensions steer every later session, oauth_creds.json must
  ; not be replaceable. state/tmp/history stay writable — that is all it needs.
  (literal "@HOME@/.gemini/settings.json")
  (literal "@HOME@/.gemini/oauth_creds.json")
  (literal "@HOME@/.gemini/google_accounts.json")
  (literal "@HOME@/.gemini/trustedFolders.json")
  (literal "@HOME@/.gemini/GEMINI.md")
  (subpath "@HOME@/.gemini/extensions")
  (subpath "@HOME@/.gemini/commands")
  (subpath "@HOME@/.gemini/hooks"))

; The working folder may be a SHARED Google Drive: anyone with write access to
; it could drop a .gemini/settings.json whose mcpServers run on this Mac the
; next time the assistant asks Gemini for a second opinion (the launcher has to
; trust the workspace, or the CLI refuses to run at all). Do not read it.
(deny file-read* (subpath "@DATA@/.gemini"))

; ── reads: broad by design, minus the things nobody should hoover up ──
; NOTE: ~/Library/Keychains is deliberately NOT denied — Claude Code stores its
; own login credentials there, and denying it leaves the session permanently
; "Not logged in". Keychain ITEMS remain protected by macOS's own per-item ACLs
; (reading the raw database yields ciphertext), so this is not a soft spot.
(deny file-read*
  (subpath "@HOME@/.ssh")
  (subpath "@HOME@/.gnupg")
  (subpath "@HOME@/.aws")
  (subpath "@HOME@/.config/gcloud")
  (subpath "@HOME@/Library/Cookies")
  (subpath "@HOME@/Library/Application Support/Firefox")
  (subpath "@HOME@/Library/Application Support/Google/Chrome")
  (subpath "@HOME@/Library/Messages")
  ; credentials a denylist must not miss
  (subpath "@HOME@/.config/gh") (literal "@HOME@/.netrc") (literal "@HOME@/.npmrc")
  (literal "@HOME@/.pypirc") (subpath "@HOME@/.kube") (subpath "@HOME@/.docker")
  ; oauth_creds.json is the credential; google_accounts.json (the account's
  ; address) must stay READABLE — the CLI opens it at exit and fails with EPERM
  ; otherwise, which the MCP bridge reports as a failed call. It is write-denied.
  (literal "@HOME@/.gemini/oauth_creds.json") (subpath "@HOME@/.codex")
  (literal "@HOME@/.claude/.credentials.json")
  ; Our own credential store under policy/: secrets the launcher hands to the
  ; session as env vars are unreadable in here (the Gemini key, access tokens).
  ; NOT the GA4 service-account JSON: the Analytics MCP server is spawned inside
  ; the session and opens that file by path — it is a Viewer-only identity, and
  ; readable is the price of that connector. settings.json / mcp.json /
  ; sandbox.sb stay readable (Claude reads them in here).
  (regex #"^@ENGINE@/policy/(gemini-key|.*-token)$")
  ; other people's mail, chat and password stores
  (subpath "@HOME@/Library/Mail")
  (subpath "@HOME@/Library/Containers/com.apple.Safari")
  (subpath "@HOME@/Library/Application Support/BraveSoftware")
  (subpath "@HOME@/Library/Application Support/Microsoft Edge")
  (subpath "@HOME@/Library/Application Support/Arc")
  (subpath "@HOME@/Library/Application Support/Slack")
  (subpath "@HOME@/Library/Application Support/1Password")
  (subpath "@HOME@/Library/Group Containers"))
