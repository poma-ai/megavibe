#!/usr/bin/env bash
# megawork-connect — turn individual services on, one at a time, when they are
# actually needed.
#
# Design note: nothing is connected by default, on purpose. Wiring up a person's
# mail, chat and CRM the moment they install something reads as creepy even when
# it is convenient. Instead the assistant notices it would need one, explains why
# in plain words, and offers — then this runs the sign-in. Consent happens at the
# moment of use, about a specific thing, and it is reversible in one command.
#
# Usage:
#   megawork-connect                 what is on, and what could be
#   megawork-connect <name>          connect it (a browser sign-in for online services; a key paste for gemini; a permission for applemail)
#   megawork-connect --off <name>    disconnect it
#
# Online services sign in through Claude Code's own OAuth: nothing to paste, and
# we never see or store a credential. Two kinds are admin-issued instead — the
# Gemini key (`key`) and access tokens such as GitHub's read-only token
# (`token`) — kept at $ENGINE/policy/ (0600, unreadable inside a session) and
# handed to the session as environment variables by the launcher.

set -uo pipefail

# Find our own engine rather than assuming the default path: these commands are
# symlinked into ~/.local/bin, and an install with a custom engine location would
# otherwise operate on a directory that does not exist.
_self="$0"
while [ -L "$_self" ]; do
  _link=$(readlink "$_self")
  case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
done
ENGINE="${MEGAWORK_HOME:-$(cd "$(dirname "$_self")/.." && pwd -P)}"
# Helpers the installer put inside the engine (Node for the MCP bridge, uv for
# the Analytics server) are on no shell's PATH by design.
[ -d "$ENGINE/tools/node/bin" ] && export PATH="$ENGINE/tools/node/bin:$PATH"
[ -d "$ENGINE/tools/uv/bin" ] && export PATH="$ENGINE/tools/uv/bin:$PATH"
B=$'\033[1m'; G=$'\033[32m'; D=$'\033[2m'; R=$'\033[0m'

# name | claude-mcp target | what a non-technical person calls it | what it is for | hidden?
# "hidden" means the installer owns it and the person is never asked — see
# README.md "Backends". It is still addressable by name so install and repair
# can run the same code path.
REGISTRY='
gmail|http https://gmailmcp.googleapis.com/mcp/v1|Gmail|search your mail, read threads, prepare drafts (never sends)
slack|http https://mcp.slack.com/mcp|Slack|find messages and threads you already have access to (never posts)
linear|http https://mcp.linear.app/mcp|Linear|look up and update issues, projects and status
hubspot|http https://mcp.hubspot.com|HubSpot|look up and update contacts, companies and deals
github|token https://api.githubcopilot.com/mcp/readonly|GitHub|read code, issues and pull requests in the company repositories
analytics|local google-analytics|Google Analytics|read website traffic and conversion reports
applemail|sandbox mail|Apple Mail (on this Mac)|search the mail already downloaded to this Mac
gemini|key gemini|Second opinions|have a second AI double-check long documents|hidden
'

row(){ printf '%s\n' "$REGISTRY" | awk -F'|' -v n="$1" '$1==n {print; exit}'; }
# Operate from the working folder: `claude mcp list` is per current directory
# for local-scope entries, and the session runs in that folder.
_data=$(cat "$ENGINE/data-dir" 2>/dev/null || true); [ -n "$_data" ] && [ -d "$_data" ] && cd "$_data"
# Registered is not the same as connected: an MCP server that has not completed
# OAuth exposes no tools at all, so treat "needs authentication" as off.
# "Connected" means authenticated. A health check that times out reports neither,
# so treat an unreadable answer as unknown rather than as off — telling someone a
# service is off when they just connected it is worse than saying nothing.
is_on(){ claude mcp list 2>/dev/null | grep "^$1[: ]" | grep -qiE '✔|✓|(^|[^a-z])connected'; }
is_registered(){ claude mcp list 2>/dev/null | grep -q "^$1[: ]"; }

# Inside a session we are sandboxed: no terminal for OAuth, and the engine and
# Google's credential store are read-only. Every connector therefore has the same
# shape — queue it, and let the launcher finish it outside the sandbox.
sandboxed(){ ! ( : > "$HOME/.megawork-sb-probe-$$" ) 2>/dev/null || { rm -f "$HOME/.megawork-sb-probe-$$"; false; }; }
queue_and_explain(){ # $1=name $2=label $3=kind
  mkdir -p "$ENGINE/logs" 2>/dev/null
  if ! printf '%s\n' "$1" > "$ENGINE/logs/pending-connect" 2>/dev/null; then
    echo "  ${B}!${R} Couldn't set that up. Run ${B}megawork-doctor${R}."; exit 1
  fi
  local what="finish signing in" then="The $2 sign-in opens by itself, and we carry on where we left off."
  case "${3:-}" in
    key)     what="finish setting this up"; then="You will be asked to paste the key from ${MEGAWORK_ADMIN_NAME:-your admin} — nothing opens, nothing to sign in to." ;;
    token)   what="finish setting this up"; then="You will be asked to paste the $2 access token from ${MEGAWORK_ADMIN_NAME:-your admin} — nothing opens, nothing to sign in to." ;;
    sandbox) what="switch this on";         then="$2 is switched on, and we carry on where we left off." ;;
  esac
  echo ""
  echo "  ${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}"
  echo "  ${B}  Last step: press Ctrl-D TWICE to $what${R}"
  echo "  ${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${R}"
  echo ""
  echo "  Hold ${B}Control${R} and tap ${B}D${R} — then do it once more."
  echo "  ${D}(the first press leaves the message box, the second closes the chat)${R}"
  echo ""
  echo "  $then"
  echo ""
  exit 0
}
mail_on(){ ! grep -q '(subpath "'"$HOME"'/Library/Mail")' "$ENGINE/policy/sandbox.sb" 2>/dev/null; }
# A key in the engine, not an env var: the launcher exports it per session, so
# a key that is present must be reported as on even from a plain shell.
gemini_on(){ [ -s "$ENGINE/policy/gemini-key" ] || [ -n "${GEMINI_API_KEY:-}" ]; }

list_all(){
  echo ""
  echo "  ${B}What your assistant can reach${R}"
  echo ""
  printf '%s\n' "$REGISTRY" | while IFS='|' read -r name target label desc hidden; do
    [ -n "${name:-}" ] || continue
    [ "${hidden:-}" = "hidden" ] && continue
    case "$name" in
      applemail) mail_on   && st="${G}on${R} " || st="${D}off${R}" ;;
      gemini)    gemini_on && st="${G}on${R} " || st="${D}off${R}" ;;
      *)         is_on "$name" && st="${G}on${R} " || st="${D}off${R}" ;;
    esac
    printf '   [%b] %-22s %s\n' "$st" "$label" "$D$desc$R"
  done
  echo ""
  echo "  Turn one on:   ${B}megawork-connect <name>${R}   (names: $(printf '%s\n' "$REGISTRY" | awk -F'|' 'NF && $5!="hidden"{printf "%s ", $1}'))"
  echo "  Turn one off:  ${B}megawork-connect --off <name>${R}"
  echo ""
  echo "  ${D}Nothing here is connected unless you ask for it. Most sign in through${R}"
  echo "  ${D}its own website (GitHub uses a read-only token from ${MEGAWORK_ADMIN_NAME:-your admin}).${R}"
  echo "  ${D}Your assistant never sends mail or posts in chat; edits in your work tools${R}"
  echo "  ${D}(Linear, HubSpot, …) are yours to make.${R}"
  echo ""
}

# Apple Mail is not an MCP server — it is the mail already on this Mac, so it is
# a sandbox read permission rather than a sign-in.
set_mail(){ # $1 = on|off
  local sb="$ENGINE/policy/sandbox.sb"
  [ -f "$sb" ] || { echo "  Setup looks incomplete — run: megawork-doctor"; exit 1; }
  chmod u+w "$sb" 2>/dev/null || true
  if [ "$1" = "on" ]; then
    sed -i '' "\|(subpath \"$HOME/Library/Mail\")|d" "$sb"
    echo "  ${G}✓${R} Apple Mail: your assistant can now read the mail on this Mac."
    echo "  ${D}It can read and search it. It cannot send, delete or change anything.${R}"
    # macOS guards the mail store separately from our sandbox: the Terminal
    # itself needs Full Disk Access, or every read fails with "authorization
    # denied" no matter what we allow. Check now rather than let that surface
    # later as a wall of errors.
    if ! sqlite3 "file:$HOME/Library/Mail/V10/MailData/Envelope Index?mode=ro" \
         "select 1 limit 1" >/dev/null 2>&1; then
      echo ""
      echo "  ${B}One more permission is needed — from macOS, not from us.${R}"
      echo "  macOS keeps mail locked unless Terminal is allowed to read it."
      echo ""
      echo "  1. Open ${B}System Settings${R} → ${B}Privacy & Security${R} → ${B}Full Disk Access${R}"
      echo "  2. Switch on ${B}Terminal${R}"
      echo "  3. Quit Terminal completely and open the assistant again"
      echo ""
      open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null || true
      echo "  ${D}(the settings page should have opened for you)${R}"
    fi
  else
    grep -q "(subpath \"$HOME/Library/Mail\")" "$sb" || \
      sed -i '' "s|  (subpath \"$HOME/Library/Messages\")|  (subpath \"$HOME/Library/Mail\")\n  (subpath \"$HOME/Library/Messages\")|" "$sb"
    echo "  ${G}✓${R} Apple Mail: closed off again."
  fi
  sandbox-exec -f "$sb" /usr/bin/true 2>/dev/null || { echo "  ${B}!${R} that change broke the settings — run: megawork-doctor"; exit 1; }
}

case "${1:-}" in
  ""|--list|list) list_all; exit 0 ;;
  --off)
    n="${2:-}"; r=$(row "$n"); [ -n "$r" ] || { echo "  Don't know '$n'. Try: megawork-connect"; exit 1; }
    case "$n" in
      applemail) set_mail off ;;
      # Only the local copy goes; the admin revokes the key at Google.
      gemini)
        if [ -f "$ENGINE/policy/gemini-key" ] && ! rm -f "$ENGINE/policy/gemini-key" 2>/dev/null; then
          echo "  ${B}!${R} Couldn't remove it from in here (the engine is read-only inside a session)."
          echo "  ${D}Run this from Terminal instead: megawork-connect --off gemini${R}"; exit 1
        fi
        # A key exported from a shell profile is not ours to remove, and saying
        # "off" while the launcher still hands it to every session is a lie.
        if [ -n "${GEMINI_API_KEY:-}" ]; then
          echo "  ${G}✓${R} Removed the key kept here."
          echo "  ${B}!${R} A GEMINI_API_KEY is still set in your shell, so it stays on."
          echo "  ${D}Whoever set that up has to take it out of your shell profile.${R}"
        else
          echo "  ${G}✓${R} Second opinions: off."
        fi ;;
      *) { claude mcp remove --scope user "$n" >/dev/null 2>&1 || claude mcp remove "$n" >/dev/null 2>&1; } && echo "  ${G}✓${R} $(printf '%s' "$r" | cut -d'|' -f3): disconnected." \
           || echo "  It wasn't connected."
         [ -f "$ENGINE/policy/$n-token" ] && { rm -f "$ENGINE/policy/$n-token" 2>/dev/null && echo "  ${D}(the stored token was removed too)${R}" || echo "  ${B}!${R} the stored token could not be removed from in here — run this from Terminal"; } ;;
    esac
    exit 0 ;;
esac

# A newly connected service must be pre-approved too, or its first tool call
# prompts — which is exactly what this profile promises never to do.
allow_tools(){
  local sfile="$ENGINE/policy/settings.json" rule="mcp__$1__*"
  [ -f "$sfile" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -e --arg r "$rule" 'any(.permissions.allow[]?; . == $r)' "$sfile" >/dev/null 2>&1 && return 0
  local mode; mode=$(stat -f '%Lp' "$sfile" 2>/dev/null || echo 444)
  chmod u+w "$sfile" 2>/dev/null
  jq --arg r "$rule" '.permissions.allow = (.permissions.allow // []) + [$r]' "$sfile" > "$sfile.tmp" 2>/dev/null \
    && mv "$sfile.tmp" "$sfile"
  chmod "$mode" "$sfile" 2>/dev/null
}

NAME="$1"; ROW=$(row "$NAME")
[ -n "$ROW" ] || { echo "  Don't know '$NAME'."; list_all; exit 1; }
LABEL=$(printf '%s' "$ROW" | cut -d'|' -f3)
DESC=$(printf '%s' "$ROW" | cut -d'|' -f4)
KIND=$(printf '%s' "$ROW" | cut -d'|' -f2 | cut -d' ' -f1)
TARGET=$(printf '%s' "$ROW" | cut -d'|' -f2 | cut -d' ' -f2-)

echo ""
echo "  ${B}Connecting $LABEL${R}"
echo "  ${D}So your assistant can $DESC.${R}"
echo ""

# Queue first, whatever the connector is: none of them can complete their work
# from inside a session (no terminal for OAuth, engine and credential stores
# read-only). This is what the launcher picks up.
sandboxed && queue_and_explain "$NAME" "$LABEL" "$KIND"

# Gemini. The key is the organisation's, not the person's: a billed project keeps prompts
# out of Google's training data (the API is only a "Paid Service" with billing
# attached — a Workspace login does NOT change that, only AI Studio's terms do),
# and the free tier is 20 requests a day on the one model a new project can
# still call. So no gcloud, no browser, no minting here: an admin hands the key
# over, it is pasted once, checked with one tiny call, and kept in the engine.
# The exact same code runs from the installer and as the repair path.
GEMINI_MODEL="${MEGAWORK_GEMINI_MODEL:-gemini-flash-latest}"
gemini_probe(){ # $1=key → rc 0 + model on stdout; rc 1 + error text on stdout; rc 2 unreachable
  local body
  body=$(curl -s --max-time 25 -X POST \
    "https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent" \
    -H "x-goog-api-key: $1" -H 'Content-Type: application/json' \
    -d '{"contents":[{"parts":[{"text":"OK"}]}],"generationConfig":{"maxOutputTokens":2}}' 2>/dev/null) || return 2
  [ -n "$body" ] || return 2                          # empty = network/throttle, not a verdict
  if printf '%s' "$body" | grep -q '"candidates"'; then
    printf '%s' "$body" | sed -n 's/.*"modelVersion": *"\([^"]*\)".*/\1/p' | head -1; return 0
  fi
  printf '%s' "$body" | sed -n 's/.*"message": *"\([^"]*\)".*/\1/p' | head -1 | cut -c1-140 | sed 's/\.$//'
  return 1
}
# The Gemini CLI on this Mac (used by the assistant for long documents) has to
# know two things: use the API key, and never wander onto a Pro model, which
# bills at 3-16x the price. setup.sh does this for developers, but it runs
# before the colleague's key exists, so it is done here as well.
gemini_configure_cli(){
  command -v jq &>/dev/null || return 0
  local s="$HOME/.gemini/settings.json"; mkdir -p "$HOME/.gemini" 2>/dev/null || return 0
  if [ -f "$s" ] && jq -e . "$s" >/dev/null 2>&1; then
    jq --arg m "$GEMINI_MODEL" '.security.auth.selectedType="gemini-api-key" | .model.name=$m' "$s" > "$s.tmp" 2>/dev/null && mv "$s.tmp" "$s"
  elif [ ! -f "$s" ]; then
    jq -n --arg m "$GEMINI_MODEL" '{security:{auth:{selectedType:"gemini-api-key"}},model:{name:$m}}' > "$s"
  fi
}
gemini_store(){ # $1=key
  mkdir -p "$ENGINE/policy" 2>/dev/null || return 1
  chmod u+w "$ENGINE/policy/gemini-key" 2>/dev/null || true
  printf '%s\n' "$1" > "$ENGINE/policy/gemini-key" && chmod 600 "$ENGINE/policy/gemini-key"
}
# Reads from the terminal, never from a pipe, and never echoes the key back.
gemini_ask_key(){ # sets REPLY_KEY; empty = skipped
  REPLY_KEY=""
  local tty=/dev/tty; [ -t 0 ] && tty=/dev/stdin
  ( : < /dev/tty ) 2>/dev/null || [ -t 0 ] || return 1
  printf '  Paste the second-opinion key from %s (Enter to skip): ' "${MEGAWORK_ADMIN_NAME:-your admin}"
  IFS= read -r -s REPLY_KEY < "$tty" || REPLY_KEY=""
  echo ""
  REPLY_KEY=$(printf '%s' "$REPLY_KEY" | tr -d '[:space:]')
}

# Admin-issued access tokens (a read-only GitHub token today): kept in the
# engine like the Gemini key, validated with one call, then registered as an
# http MCP server with an Authorization header. Read-only is the TOKEN's
# property (fine-grained, no write scopes) — nothing here has to guess tool names.
token_file(){ printf '%s' "$ENGINE/policy/$1-token"; }
token_probe(){ # $1=name $2=token → rc 0 + identity on stdout, rc 1 rejected, rc 2 unreachable
  case "$1" in
    github) local b; b=$(curl -s --max-time 20 -H "Authorization: Bearer $2" -H 'Accept: application/vnd.github+json' https://api.github.com/user 2>/dev/null) || return 2
            [ -n "$b" ] || return 2
            printf '%s' "$b" | jq -e '.login' >/dev/null 2>&1 && { printf '%s' "$b" | jq -r '.login'; return 0; }
            printf '%s' "$b" | jq -r '.message // "rejected"' | cut -c1-120; return 1 ;;
    *) return 2 ;;
  esac
}
token_ask(){ REPLY_TOKEN=""; local tty=/dev/tty; [ -t 0 ] && tty=/dev/stdin; ( : < /dev/tty ) 2>/dev/null || [ -t 0 ] || return 1
  printf '  Paste the %s access token from %s (Enter to skip): ' "$1" "${MEGAWORK_ADMIN_NAME:-your admin}"; IFS= read -r -s REPLY_TOKEN < "$tty" || REPLY_TOKEN=""; echo ""
  REPLY_TOKEN=$(printf '%s' "$REPLY_TOKEN" | tr -d '[:space:]'); }

case "$KIND" in
  sandbox) set_mail on ;;

  token)
    TF=$(token_file "$NAME")
    if [ ! -s "$TF" ]; then
      echo "  $LABEL needs an access token from ${MEGAWORK_ADMIN_NAME:-your admin} — nothing to sign in to."
      echo ""
      token_ask "$LABEL" || { echo "  ${D}No terminal to paste into. Run this again from Terminal: megawork-connect $NAME${R}"; exit 1; }
      [ -n "$REPLY_TOKEN" ] || { echo "  ${B}$LABEL is not set up.${R} To add it later: ${B}megawork-connect $NAME${R}"; echo ""; exit 3; }
      WHO=$(token_probe "$NAME" "$REPLY_TOKEN"); rc=$?
      case $rc in
        0) mkdir -p "$ENGINE/policy"; chmod u+w "$TF" 2>/dev/null || true; printf '%s\n' "$REPLY_TOKEN" > "$TF" && chmod 600 "$TF" || { echo "  ${B}!${R} Could not save the token. Run megawork-doctor."; exit 1; } ;;
        2) echo "  ${B}!${R} Could not reach $LABEL to check the token — is the internet on? Nothing was saved."; exit 1 ;;
        *) echo "  ${B}!${R} That token was not accepted${WHO:+: $WHO}. Ask ${MEGAWORK_ADMIN_NAME:-your admin} for a fresh one."; exit 1 ;;
      esac
    fi
    TOK=$(tr -d '[:space:]' < "$TF")
    WHO=$(token_probe "$NAME" "$TOK"); rc=$?
    [ "$rc" -eq 2 ] && { echo "  Could not reach $LABEL right now — is the internet on? Nothing was changed."; exit 1; }
    [ "$rc" -eq 0 ] || { echo "  ${B}!${R} The stored $LABEL token no longer works${WHO:+ ($WHO)}. Remove it with --off $NAME and set it up again with a fresh one from ${MEGAWORK_ADMIN_NAME:-your admin}."; exit 1; }
    # The registration carries a PLACEHOLDER, not the token: Claude Code expands
    # ${VAR} in MCP headers at connect time, and the launcher exports the value
    # from the 0600 file. So ~/.claude.json never holds the secret and `ps` never
    # shows it. X-MCP-Readonly makes GitHub's server expose no write tools — the
    # token is read-only by construction, this is the second belt.
    is_registered "$NAME" && claude mcp remove --scope user "$NAME" >/dev/null 2>&1
    VAR="MEGAWORK_TOKEN_$(printf '%s' "$NAME" | tr 'a-z-' 'A-Z_')"
    claude mcp add --scope user --transport http "$NAME" "$TARGET" --header "Authorization: Bearer \${$VAR}" --header "X-MCP-Readonly: true" >/dev/null 2>&1 \
      || { echo "  ${B}!${R} Could not register $LABEL. Nothing else was changed."; exit 1; }
    allow_tools "$NAME"
    echo "  ${G}✓${R} $LABEL connected ${D}(as $WHO; token issued read-only by ${MEGAWORK_ADMIN_NAME:-your admin})${R}." ;;

  key)
    # A key that is present but dead (revoked, project closed) must not read
    # as "already set up" forever — probe it, and offer to replace it.
    if gemini_on; then
      CUR=$(tr -d '[:space:]' < "$ENGINE/policy/gemini-key" 2>/dev/null || true); CUR="${CUR:-${GEMINI_API_KEY:-}}"
      M=$(gemini_probe "$CUR"); rc=$?
      case $rc in
        0) # An admin's key handed over via the environment is kept in the engine
           # from here on, so it survives a shell without that variable.
           [ -s "$ENGINE/policy/gemini-key" ] || gemini_store "$CUR" 2>/dev/null || true
           gemini_configure_cli
           echo "  Already set up ${D}(answers as ${M:-$GEMINI_MODEL})${R}."
           echo "  ${D}To replace the key: megawork-connect --off gemini, then megawork-connect gemini.${R}"
           echo ""; exit 0 ;;
        2) echo "  A key is in place, but Google could not be reached to check it. Try again later."; echo ""; exit 0 ;;
        *) echo "  ${B}!${R} The key in place no longer works${M:+ ($M)}."
           echo "  A new one is needed — ask ${MEGAWORK_ADMIN_NAME:-your admin}." ;;
      esac
    fi
    echo "  Second opinions need a key from ${MEGAWORK_ADMIN_NAME:-your admin} — nothing to sign in to."
    echo ""
    for _try in 1 2 3; do
      gemini_ask_key || { echo "  ${D}No terminal to paste into. Run this again from Terminal: megawork-connect gemini${R}"; exit 1; }
      if [ -z "$REPLY_KEY" ]; then
        echo ""
        echo "  ${B}Second opinions are not set up.${R} Everything else works; the assistant"
        echo "  will say so when it would have used one. To add it later:"
        echo "     ${B}megawork-connect gemini${R}   (with the key from ${MEGAWORK_ADMIN_NAME:-your admin})"
        echo ""; exit 3
      fi
      M=$(gemini_probe "$REPLY_KEY"); rc=$?
      case $rc in
        0) gemini_store "$REPLY_KEY" || { echo "  ${B}!${R} Could not save the key (is $ENGINE writable?). Run megawork-doctor."; exit 1; }
           gemini_configure_cli
           echo "  ${G}✓${R} Second opinions are on ${D}(${M:-$GEMINI_MODEL})${R}."
           echo ""; exit 0 ;;
        2) echo "  ${B}!${R} Could not reach Google to check the key — is the internet on? Nothing was saved."; exit 1 ;;
        *) echo "  ${B}!${R} That key was not accepted${M:+: $M}."
           [ "$_try" -lt 3 ] && echo "  ${D}Check for a missing character and paste it again.${R}" ;;
      esac
    done
    echo "  ${D}Ask ${MEGAWORK_ADMIN_NAME:-your admin} for a fresh key — nothing was saved.${R}"
    exit 1 ;;
  http)
    if is_on "$NAME"; then echo "  Already connected."; exit 0; fi
    echo "  A browser window will open so you can sign in to $LABEL."
    echo "  ${D}You are signing in to $LABEL itself — no password is shared with us.${R}"
    echo ""
    # A half-finished attempt leaves the server registered but not signed in;
    # in that case skip straight to the sign-in rather than failing on "exists".
    if ! is_registered "$NAME"; then
      claude mcp add --scope user --transport http "$NAME" "$TARGET" >/dev/null 2>&1 || {
        echo "  ${B}!${R} Could not reach $LABEL. Nothing was changed."; exit 1; }
    fi
    # Sign in NOW, with the browser opening by itself. Until this completes the
    # server exposes no tools at all, so "just ask and it'll prompt you" would
    # be wrong — and typing a slash command is not something to ask of someone
    # who was promised they would never need to.
    # Run it straight, with no pipe and no redirect: piping makes stdout a
    # non-terminal, so the sign-in never opens a browser, `tail` swallows the
    # progress messages, and the `if` would test tail's exit status instead of
    # the sign-in's. That combination looked exactly like a hang.
    if claude mcp login "$NAME"; then
      if claude mcp list 2>/dev/null | grep "^$NAME[: ]" | grep -qi 'needs authentication'; then
        # Exit non-zero: the launcher reads this status to decide whether to
        # tell the resumed session the service is there. It is not.
        echo "  ${B}!${R} Not signed in yet. Run this again when you have a moment."; exit 1
      else
        allow_tools "$NAME"
        echo "  ${G}✓${R} $LABEL connected."
      fi
    else
      # Out here we HAVE a terminal (the in-session case was queued above and
      # exited), so a failed sign-in is simply a failed sign-in. Re-queueing it
      # from here made the launcher loop forever on a login that kept failing.
      echo "  ${B}!${R} The $LABEL sign-in did not complete. Nothing was changed —"
      echo "     run ${B}megawork-connect $NAME${R} again when you have a moment."
      exit 1
    fi ;;

  local)
    # GA4 is different from the OAuth connectors on purpose. The Analytics Data
    # API does not accept API keys at all — reports are authorised per GA4
    # property, so it needs a real identity: either the person's Google login,
    # or a service account an admin has granted Viewer on the property. That is
    # why the admin-file route is the only sign-in-free option here.
    #
    # Preferred: an admin-provisioned service account sitting in the engine, so
    # the person never touches authentication at all.
    SA="$ENGINE/policy/ga4-service-account.json"
    RUNNER=$(command -v uvx || command -v pipx || true)
    if [ -f "$SA" ] && [ -n "$RUNNER" ]; then
      claude mcp add --scope user analytics -e "GOOGLE_APPLICATION_CREDENTIALS=$SA" -- \
        "$RUNNER" google-analytics-mcp >/dev/null 2>&1 \
        && { echo "  ${G}✓${R} Google Analytics connected (read-only, using the account your admin set up)."; \
             echo "  ${D}Nothing to sign in to — it is already authorised.${R}"; } \
        || { echo "  ${B}!${R} Could not add it. Ask your admin to check megawork-doctor."; exit 1; }
      echo ""; exit 0
    fi

    if ! command -v gcloud &>/dev/null || ! { command -v uvx &>/dev/null || command -v pipx &>/dev/null; }; then
      echo "  Google Analytics is the one service that needs a piece of setup"
      echo "  from whoever looks after this Mac — it cannot be self-served."
      echo ""
      echo "  ${D}For them: install gcloud and uv, or drop a GA4 service-account${R}"
      echo "  ${D}key at $ENGINE/policy/ga4-service-account.json — then this${R}"
      echo "  ${D}connects with no sign-in at all.${R}"
      echo ""; exit 1
    fi

    echo "  A Google sign-in window will open now. Choose your work account."
    echo "  ${D}This is Google's own sign-in — read-only access to your reports.${R}"
    echo ""
    # Opens the browser itself; no command for anyone to remember.
    # Same rule as the sign-in above: no pipe. gcloud needs the real terminal to
    # open a browser, and piping would silently turn this into a hang.
    if gcloud auth application-default login; then
      RUNNER=$(command -v uvx || command -v pipx || true)
      [ -n "$RUNNER" ] || { echo "  ${B}!${R} Needs uvx or pipx installed first."; exit 1; }
      claude mcp add --scope user analytics -- "$RUNNER" google-analytics-mcp >/dev/null 2>&1 \
        && echo "  ${G}✓${R} Google Analytics connected (read-only)." \
        || { echo "  ${B}!${R} Signed in, but the connector could not be added."; exit 1; }
    else
      echo "  ${B}!${R} Sign-in did not complete. Nothing was changed."; exit 1
    fi ;;
esac

echo ""
echo "  Open your assistant and just ask — it will use it from now on."
echo "  ${D}Changed your mind? megawork-connect --off $NAME${R}"
echo ""
