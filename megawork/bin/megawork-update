#!/usr/bin/env bash
# megawork-update — bring this Mac's assistant up to date.
#
# A colleague's machine has no repo checkout and nobody to run git for them, so
# updating fetches the current release as a tarball and re-runs the installer,
# which is idempotent. Their folder, their history and their connections are
# untouched — only the engine is replaced.
#
# Usage: megawork-update [--check]

set -uo pipefail

_self="$0"
while [ -L "$_self" ]; do
  _link=$(readlink "$_self")
  case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
done
ENGINE="${MEGAWORK_HOME:-$(cd "$(dirname "$_self")/.." && pwd -P)}"
B=$'\033[1m'; G=$'\033[32m'; D=$'\033[2m'; R=$'\033[0m'

[ -d "$ENGINE" ] || { echo "megawork is not set up on this Mac."; exit 1; }
DATA=$(cat "$ENGINE/data-dir" 2>/dev/null || echo "")
# Never substitute a different folder. A Drive folder that is offline for a
# minute would otherwise be replaced by an empty ~/megawork, with "your folder
# is unchanged" printed underneath. Wait for it, or stop.
if [ -z "$DATA" ]; then
  echo "  This setup does not say where your folder is — run megawork-doctor and tell whoever set it up."; exit 1
fi
if [ ! -d "$DATA" ]; then
  echo "  Your folder is not reachable right now ($DATA)."
  echo "  ${D}If it lives in Google Drive, wait for Drive to finish syncing, then try again. Nothing was changed.${R}"; exit 1
fi

# --if-due is no longer wired into launch (see bin/megawork). It remains for a
# caller that wants "install only if due". The due check stays BEFORE the
# network call so such a caller pays no curl on a checked-today run.
if [ "${1:-}" = "--if-due" ]; then
  _stamp="$ENGINE/logs/.update-checked"
  mkdir -p "$ENGINE/logs" 2>/dev/null || true
  [ -f "$_stamp" ] && [ -z "$(find "$_stamp" -mtime +1 2>/dev/null)" ] && exit 0
  # A health check must not silently replace the software it is auditing.
  case "${MEGAWORK_NONINTERACTIVE:-}" in 1|true|yes) exit 0 ;; esac
fi

# Scoped to this subtree, not the whole repository: otherwise every commit to
# megavibe would tell a colleague their assistant needs updating.
REMOTE_SHA=$(curl -fsSL --max-time 20 \
  "https://api.github.com/repos/poma-ai/megavibe/commits?path=megawork&per_page=1" 2>/dev/null \
  | sed -n 's/.*"sha": *"\([0-9a-f]\{7\}\).*/\1/p' | head -1)
LOCAL_SHA=$(cat "$ENGINE/version" 2>/dev/null || echo "")

# --if-due: what the launcher runs at every start (bin/megawork, from a temp
# copy). Silent and instant unless there is genuinely something to install, so
# it can sit in the startup path.
if [ "${1:-}" = "--if-due" ]; then
  STAMP="$ENGINE/logs/.update-checked"
  mkdir -p "$ENGINE/logs" 2>/dev/null || true
  # Checked today already: say nothing, cost nothing.
  if [ -f "$STAMP" ] && [ -z "$(find "$STAMP" -mtime +1 2>/dev/null)" ]; then
    exit 0
  fi
  touch "$STAMP" 2>/dev/null || true
  if [ -z "$REMOTE_SHA" ] || [ -z "$LOCAL_SHA" ] || [ "$REMOTE_SHA" = "$LOCAL_SHA" ]; then
    exit 0                      # offline, unknown, or current — start the session
  fi
  set --                        # due and available: fall through and install it
fi

if [ "${1:-}" = "--check" ]; then
  # Unknown local version (older install, offline stamp) is not evidence of an
  # update; claiming one sends people into a re-install that changes nothing.
  if [ -n "$REMOTE_SHA" ] && [ -n "$LOCAL_SHA" ] && [ "$REMOTE_SHA" != "$LOCAL_SHA" ]; then
    echo "update available"; exit 0
  fi
  echo "up to date"; exit 1
fi

echo ""
echo "  ${B}Updating your assistant${R}"
if [ -n "$REMOTE_SHA" ] && [ "$REMOTE_SHA" = "$LOCAL_SHA" ]; then
  echo "  ${G}✓${R} Already up to date."; echo ""; exit 0
fi

TMP=$(mktemp -d) || { echo "  Couldn't prepare the download."; exit 1; }
trap 'rm -rf "$TMP"' EXIT
echo "  Downloading…"
curl -fsSL --max-time 120 https://codeload.github.com/poma-ai/megavibe/tar.gz/refs/heads/main \
  | tar -xz -C "$TMP" 2>/dev/null || { echo "  The download failed — nothing was changed."; exit 1; }
SRC=$(find "$TMP" -maxdepth 1 -type d -name 'megavibe-*' | head -1)
[ -n "$SRC" ] && [ -d "$SRC/megawork" ] || { echo "  The download looked wrong — nothing was changed."; exit 1; }

# Keep a copy of the working engine: an update that breaks the launcher would
# otherwise leave someone non-technical with no way back.
BACKUP="$ENGINE.previous"
rm -rf "$BACKUP"
# Skip $ENGINE/tools: a downloaded gcloud SDK plus a managed Python is hundreds
# of megabytes and re-fetchable; copying it is the likeliest way for this backup
# to fail. tar, not cp: it takes dotfiles, and with pipefail a short copy fails.
mkdir -p "$BACKUP" \
  && ( cd "$ENGINE" && tar -cf - --exclude './tools' . 2>/dev/null ) | ( cd "$BACKUP" && tar -xf - 2>/dev/null ) \
  || { rm -rf "$BACKUP"; echo "  Couldn't safely back up the current setup, so nothing was changed."; echo "  ${D}Check there is free disk space, then try again.${R}"; exit 1; }
# No usable backup means no safe rollback, so do not start something we cannot
# undo. Verify the pieces a person cannot live without, not just one file.
for _need in bin/megawork bin/megawork-doctor bin/megawork-update policy/settings.json policy/sandbox.sb data-dir; do
  [ -s "$BACKUP/$_need" ] || { rm -rf "$BACKUP"; echo "  The backup came out incomplete ($_need), so nothing was changed. Try again."; exit 1; }
done
restore(){
  if [ -d "$ENGINE/tools" ] && [ ! -d "$BACKUP/tools" ]; then
    mv "$ENGINE/tools" "$BACKUP/tools" 2>/dev/null || { echo "  ${B}!${R} could not preserve $ENGINE/tools — leaving the engine as it is"; return 1; }
  fi
  rm -rf "$ENGINE"; mv "$BACKUP" "$ENGINE"
}

# NONINTERACTIVE, not just </dev/null: init.sh falls back to /dev/tty when
# stdin is closed, so without this an update stops on a prompt (or a browser
# sign-in) while its own output is going to /dev/null. Nobody sees why.
if MEGAWORK_HOME="$ENGINE" MEGAWORK_WRAPPED=1 MEGAWORK_NONINTERACTIVE=1 \
   bash "$SRC/megawork/init.sh" --data "$DATA" </dev/null >/dev/null 2>&1; then
  # Stamp something even when GitHub's API was rate-limited, or the launcher
  # nags "update available" every week and each run re-downloads to change nothing.
  printf '%s\n' "${REMOTE_SHA:-installed-$(date +%Y%m%d)}" > "$ENGINE/version"
  # Prove it still works before declaring success. NONINTERACTIVE because the
  # doctor launches the real thing to probe it, and the real thing finishes any
  # queued service sign-in — a browser nobody asked for, in a run whose output
  # is going to /dev/null.
  DOC=$(MEGAWORK_HOME="$ENGINE" MEGAWORK_NONINTERACTIVE=1 \
        bash "$ENGINE/bin/megawork-doctor" 2>&1); DOC_RC=$?
  # Judge the INSTALL, not the person: being signed out of Claude is the one
  # doctor failure that is theirs, not the update's. Every other ✗ is a reason
  # to roll back — enumerate the allowed one, never the fatal ones (a list of
  # fatal words accepted "cannot write inside the folder" and rolled back on a
  # missing jq forever).
  # Also allowed: conditions of the MACHINE that predate the update and that
  # the old version suffered equally (no jq on macOS 14, Claude not installed).
  # And a TIMED-OUT probe: the doctor grades that ✗ so a crashed launcher is
  # caught, but a cold start inside a seatbelt on a loaded Mac can exceed the
  # 150s alarm with nothing wrong. Updates are manual now, so this gate is the
  # ONLY channel a fix travels — rejecting a good update and telling a
  # non-technical person their assistant is broken is the worse error here.
  OTHER_BAD=$(printf '%s\n' "$DOC" | grep '✗' \
    | grep -Ev '^ *✗ (not signed in — run|jq is missing — undo|Claude Code is not installed$|the launch probe produced no output)' || true)
  # A doctor that crashed (non-zero, but printed no ✗ at all) proved nothing —
  # that is a rollback, not a pass.
  DOC_RAN=0; printf '%s\n' "$DOC" | grep -qE '✓|✗' && DOC_RAN=1
  # Gate on EVIDENCE, not on the exit code. megawork-doctor exits 1 for every
  # ✗, including the three this code deliberately forgives (not signed in, jq
  # missing, Claude not installed) — so ANDing DOC_RC here silently deleted the
  # whitelist above and made a signed-out Mac roll back every update, forever.
  # DOC_RAN proves the doctor actually produced a verdict; OTHER_BAD proves no
  # unforgiven ✗ appeared. A crashed launcher now yields a ✗ (doctor's
  # catch-all), so it lands in OTHER_BAD and still fails the gate.
  if [ "$DOC_RAN" -eq 1 ] && [ -z "$OTHER_BAD" ]; then
    rm -rf "$BACKUP"
    echo "  ${G}✓${R} Updated. Your folder, history and connections are unchanged."
    printf '%s' "$DOC" | grep -q 'not signed in' && \
      echo "  ${D}You are signed out of Claude — run 'claude' once to sign back in.${R}"
  else
    restore
    echo "  ${B}!${R} The update did not check out, so I put the working version back."
    echo "  ${D}Nothing was lost. Tell whoever set this up.${R}"; exit 1
  fi
else
  restore
  echo "  ${B}!${R} The update failed and the previous version was restored."; exit 1
fi
echo ""
