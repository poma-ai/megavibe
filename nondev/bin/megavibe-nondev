#!/usr/bin/env bash
# megavibe-nondev launcher — starts a jailed, plain-language Claude session.
#
# Implements the launch contract proven by nondev/spike/jail-spike.sh (10/10):
#   claude --restricted --strict-mcp-config --mcp-config <policy> \
#          --settings <policy> --add-dir <data folder>
#
#   --restricted        removes Bash/code tools and WebFetch, confines file
#                       tools to the working directories, refuses bypass mode,
#                       and ignores user/project settings (so a colleague's
#                       stray ~/.claude config cannot widen the jail)
#   --settings          the admin-owned policy IS still honoured (verified)
#   --strict-mcp-config no MCP servers, including account-level claude.ai
#                       connectors (verified absent)
#
# The control plane (this script, policy, protocol) lives OUTSIDE the data
# folder on purpose: a session that can write the folder must never be able to
# rewrite its own guardrails.

set -euo pipefail

ENGINE="${MEGAVIBE_NONDEV_HOME:-$HOME/.megavibe-nondev}"
DATA_DEFAULT="$HOME/megavibe-nondev"

[ -d "$ENGINE" ] || { echo "megavibe-nondev is not set up on this Mac yet."; exit 1; }

DATA=$(cat "$ENGINE/data-dir" 2>/dev/null || echo "$DATA_DEFAULT")
POLICY="$ENGINE/policy"
PROTOCOL="$ENGINE/prompts/CLAUDE-nondev.md"

for f in "$POLICY/settings.json" "$POLICY/mcp.json" "$PROTOCOL"; do
  [ -f "$f" ] || { echo "Something is missing from the setup ($(basename "$f")). Ask your admin to re-run the installer."; exit 1; }
done
[ -d "$DATA" ] || { echo "Your folder is missing. Ask your admin to re-run the installer."; exit 1; }

command -v claude &>/dev/null || { echo "Claude is not installed on this Mac. Ask your admin."; exit 1; }

# Never let a stray environment variable loosen the jail.
unset CLAUDE_CODE_DANGEROUSLY_SKIP_PERMISSIONS ANTHROPIC_API_KEY 2>/dev/null || true

cd "$DATA"

# The containment boundary is the macOS sandbox, NOT Claude's own flags:
# --restricted confines Claude's file tools but leaves Bash free to read and
# write anywhere (proven in nondev/spike/RESULTS-capable.md). Enforcing in the
# kernel instead lets the assistant keep Bash, MCP servers and the colleague's
# own claude.ai connectors — capability the colleague actually needs — while
# writes stay inside their folder and secrets stay unreadable.
SANDBOX="$ENGINE/policy/sandbox.sb"
CLAUDE_ARGS=(
  --settings "$POLICY/settings.json"
  --add-dir "$DATA"
  --add-dir "$ENGINE/snapshots"
  --append-system-prompt "$(cat "$PROTOCOL")"
)

# Remote Control: the session still starts HERE, inside the sandbox and under
# the admin policy — the Claude app merely attaches to it. That is the safe way
# to give a non-technical colleague a phone/desktop app interface: starting a
# session from inside the app instead would bypass the sandbox entirely.
# Filter --remote out properly. ${@/--remote/} is a per-element SUBSTRING
# substitution, not removal: it left an empty argv element, mangled
# --remote-control into -control, and corrupted any prompt containing the text.
REMOTE=0
case "${MEGAVIBE_NONDEV_REMOTE:-}" in 1|true|yes) REMOTE=1 ;; esac
REST=()
for a in "$@"; do
  if [ "$a" = "--remote" ]; then REMOTE=1; else REST+=( "$a" ); fi
done
[ "$REMOTE" -eq 1 ] && CLAUDE_ARGS+=( --remote-control "${MEGAVIBE_NONDEV_REMOTE_NAME:-Megavibe}" )
set -- ${REST+"${REST[@]}"}

# Probe the profile: `-f exists` is not the same as `it loads`. A syntax error
# otherwise dumps a C-style seatbelt backtrace into the colleague's window.
if [ -f "$SANDBOX" ] && command -v sandbox-exec &>/dev/null \
   && sandbox-exec -f "$SANDBOX" /usr/bin/true 2>/dev/null; then
  exec sandbox-exec -f "$SANDBOX" claude "${CLAUDE_ARGS[@]}" "$@"
fi

# No sandbox available (non-macOS, or profile missing): fall back to Claude's
# own restricted mode. Less capable — no Bash, no connectors — but never
# unconfined, because an unconfined session is the one outcome we refuse.
echo "note: running in reduced-capability mode (no OS sandbox available)" >&2
exec claude --restricted --strict-mcp-config --mcp-config "$POLICY/mcp.json" \
  "${CLAUDE_ARGS[@]}" "$@"
