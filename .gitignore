# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# macOS
.DS_Store

# Megavibe project context (generated by init.sh)
/.agent/

# Live hooks/rules/skills (generated by init.sh from template/)
/.claude/hooks/
/.claude/rules/
/.claude/skills/
/.claude/agents/
/.claude/settings.json
/.claude/verify.sh
/.claude/verify.sh.example

# Personal overrides (not shared)
CLAUDE.local.md

# poma-memory database (generated at runtime)
.poma-memory.db*

# Playwright MCP scratch (browser snapshots/screenshots)
.playwright-mcp/

# Editor
*.swp
*.swo
*~
.vscode/
.idea/
events.jsonl

# Org-specific Megawork overlay (branding, named pilots) — this repo is PUBLIC.
# Keep these in ~/.megavibe/personal/megawork/ instead.
# (Paths said 'nondev/' until the rename, so they guarded nothing. An icon and a
# named pilot brief have each landed here once and cost a history rewrite.)
megawork/template/icon.*
megawork/**/icon.*
megawork/PILOT-BRIEF.md
megawork/org/
nondev/
README-data-treatment.md
scripts/gcp-token.sh

# Runtime state — never belongs in the repo
megawork/logs/
