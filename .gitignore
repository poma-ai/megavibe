# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# macOS
.DS_Store

# Megavibe project context (generated by init.sh)
/.agent/

# Visible deliverables folder (STATUS.md, reports); never committed. No trailing slash: a worktree links it.
/megavibe-deliverables

# Live hooks/rules/skills (generated by init.sh from template/)
/.claude/hooks/
/.claude/rules/
/.claude/skills/
/.claude/agents/
/.claude/settings.json
/.claude/verify.sh
/.claude/verify.sh.example

# Personal overrides (not shared)
CLAUDE.local.md

# poma-memory database (generated at runtime)
.poma-memory.db*

# Playwright MCP scratch (browser snapshots/screenshots)
.playwright-mcp/

# Editor
*.swp
*.swo
*~
.vscode/
.idea/
events.jsonl

README-data-treatment.md
scripts/gcp-token.sh

# Admin-issued credentials (a leftover Megawork overlay's) — these live in the private overlay, never here.
**/gemini-key
**/*-token
**/*-password
**/*-service-account.json
# Organisation-local config (the shipped examples are org.example.json / tools.example.yaml)
**/org.json
**/tools.yaml

# The removed Megawork profile: local residue (icons, pilot briefs, org/, logs/)
# from an older checkout must never be committed to this public repo.
megawork/
